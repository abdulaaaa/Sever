{
  "manifest_version": 3,
  "name": "My Page Blocker",
  "version": "3.0",
  "description": "Blocks pages and sites, on schedules and with a daily social media limit, synced through Supabase.",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "storage",
    "alarms",
    "idle",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Page Blocker",
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/16.png",
      "32": "src/assets/icons/32.png",
      "48": "src/assets/icons/48.png"
    }
  },
  "icons": {
    "16": "src/assets/icons/16.png",
    "32": "src/assets/icons/32.png",
    "48": "src/assets/icons/48.png",
    "128": "src/assets/icons/128.png"
  },
  "options_ui": {
    "page": "src/pages/options/options.html",
    "open_in_tab": true
  },
  "incognito": "split",
  "web_accessible_resources": [
    {
      "resources": [
        "src/pages/blocked/blocked.html",
        "src/pages/blocked/blocked.js",
        "src/assets/styles/theme.css",
        "src/utils/common.js",
        "src/services/supa.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}