{
  "manifest_version": 3,
  "name": "Sever",
  "version": "3.0",
  "description": "Blocks pages and sites, on schedules and with a daily social media limit, synced through Supabase.",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "storage",
    "alarms",
    "idle",
    "notifications",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Sever",
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "16": "src/assets/icons/16.png",
      "32": "src/assets/icons/32.png",
      "48": "src/assets/icons/48.png"
    }
  },
  "icons": {
    "16": "src/assets/icons/16.png",
    "32": "src/assets/icons/32.png",
    "48": "src/assets/icons/48.png",
    "128": "src/assets/icons/128.png"
  },
  "options_ui": {
    "page": "src/pages/options/index.html",
    "open_in_tab": true
  },
  "incognito": "split",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/countdown.ts", "src/content/typing.ts", "src/content/focus.ts"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pages/blocked/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
